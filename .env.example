# Banco de dados (Docker Compose)
POSTGRES_DB=passe
POSTGRES_USER=passe
POSTGRES_PASSWORD=passe
POSTGRES_PORT=5432

# Backend (Spring Boot)
# Porta, banco, usuário e senha precisam bater com os valores acima
DB_URL=jdbc:postgresql://localhost:5432/passe
DB_USER=passe
DB_PASSWORD=passe
SERVER_PORT=8080

# Origem do frontend aceita pelo CORS (várias: separe por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000